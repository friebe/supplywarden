{
  "name": "supplywarden",
  "version": "0.1.0",
  "description": "Supply-chain governance for npm projects — triage, audited overrides, and compliance checks",
  "type": "module",
  "bin": {
    "supplywarden": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "try": "vpx src/cli.ts",
    "check": "vp check",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "author": {
    "name": "Jan Friebe",
    "email": "kontakt@jan-friebe.de"
  },
  "bugs": {
    "email": "kontakt@jan-friebe.de"
  },
  "keywords": [
    "supply-chain",
    "governance",
    "compliance",
    "dependabot",
    "overrides",
    "security"
  ],
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "commander": "^12.1.0",
    "semver": "^7.6.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/semver": "^7.5.8",
    "typescript": "^5.7.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "vite@*": "npm:@voidzero-dev/vite-plus-core@1.4.0",
      "vitest@*": "5.0.5"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ],
      "allowedVersions": {
        "vite": "*"
      }
    }
  }
}
